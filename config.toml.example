# Configuration de cryptoapi — toute clé absente conserve sa valeur par défaut.
#
# Copiez ce fichier vers config.toml puis renseignez le token :
#   cp config.toml.example config.toml
#
# config.toml n'est PAS suivi par git (il contient le token Grist) ;
# ce fichier d'exemple, lui, est suivi et ne doit contenir aucun secret réel.

# Port d'écoute du serveur HTTP
port = 3040

# Intervalle de mise à jour des prix, en secondes
update_interval_seconds = 300

# Fichier de cache des prix (hors /tmp : survit aux redémarrages et reboots,
# sert de dernières valeurs connues si un fetch échoue)
prices_file = "/var/lib/cryptoapi/prices.json"

# API Grist : mise à jour du tableau Coins après chaque fetch réussi
grist_api_url = "https://grist.example.com/api/docs/<doc_id>/tables/Coins/records"
grist_bearer_token = "REPLACE_WITH_YOUR_GRIST_TOKEN"
